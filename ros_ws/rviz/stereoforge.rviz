Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /ZED 2 Rectified RGB (Natural)1
        - /ZED 2 Depth Measured (Colorized)1
        - /ZED 2 Depth Completed v9.3 (Colorized)1
        - /ZED 2 Depth Person-Refined (Colorized)1
        - /RealSense D435i RGB1
        - /RealSense D435i Depth (Colorized)1
      Splitter Ratio: 0.5
    Tree Height: 480
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/rectified_rgb_natural
      Max Value: 1
      Min Value: 0
      Name: ZED 2 Rectified RGB (Natural)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/depth_colorized
      Max Value: 1
      Min Value: 0
      Name: ZED 2 Depth Measured (Colorized)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/depth_completed_colorized
      Max Value: 1
      Min Value: 0
      Name: ZED 2 Depth Completed v9.3 (Colorized)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/depth_person_colorized
      Max Value: 1
      Min Value: 0
      Name: ZED 2 Depth Person-Refined (Colorized)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /realsense/rectified_rgb
      Max Value: 1
      Min Value: 0
      Name: RealSense D435i RGB
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /realsense/depth_colorized
      Max Value: 1
      Min Value: 0
      Name: RealSense D435i Depth (Colorized)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/rectified_rgb
      Max Value: 1
      Min Value: 0
      Name: ZED 2 Raw Rectified RGB
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/depth
      Max Value: 3.5
      Median window: 5
      Min Value: 0.5
      Name: ZED 2 Raw Depth Measured (m)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/depth_completed
      Max Value: 3.5
      Median window: 5
      Min Value: 0.5
      Name: ZED 2 Raw Depth Completed v9.3 (m)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereoforge/depth_completed_provenance
      Max Value: 6
      Min Value: 0
      Name: ZED 2 Completed Provenance (0=Inv, 1=Meas, 6=Planar)
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: false
      Image Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /realsense/depth
      Max Value: 3.5
      Median window: 5
      Min Value: 0.5
      Name: RealSense D435i Raw Depth (m)
      Normalize Range: false
      Transport Hint: raw
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: stereoforge_camera
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.785398
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1020
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: ""
  Views:
    collapsed: false
  Width: 1680
  X: 60
  Y: 40
