include_guard(GLOBAL)
option(STEREOFORGE_NATIVE_CAPTURE_ZED "Enable physical ZED source in standalone native capture" ON)
find_package(Threads REQUIRED)
add_library(stereoforge_capture src/capture.cpp)
target_link_libraries(stereoforge_capture PUBLIC stereoforge_contracts PRIVATE Threads::Threads)
target_compile_features(stereoforge_capture PUBLIC cxx_std_20)
if(STEREOFORGE_NATIVE_CAPTURE_ZED)
  include("${CMAKE_CURRENT_LIST_DIR}/ZedCapture.cmake")
  target_link_libraries(stereoforge_capture PRIVATE stereoforge_zed_private)
  target_compile_definitions(stereoforge_capture PRIVATE SF_NATIVE_CAPTURE_ZED=1)
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/native/licenses")
  foreach(name zed-open-capture-MIT.txt hidapi-BSD-3-Clause.txt)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/../third_party/licenses/${name}" "${CMAKE_BINARY_DIR}/native/licenses/${name}" COPYONLY)
  endforeach()
endif()
add_executable(native_capture_benchmark apps/native_capture_benchmark.cpp)
target_link_libraries(native_capture_benchmark PRIVATE stereoforge_capture)
if(BUILD_TESTING)
  add_executable(native_capture_contracts tests/native_capture.cpp)
  target_link_libraries(native_capture_contracts PRIVATE stereoforge_capture)
  add_test(NAME native_capture_cpu_contracts COMMAND native_capture_contracts $<TARGET_FILE:native_capture_benchmark>)
endif()
