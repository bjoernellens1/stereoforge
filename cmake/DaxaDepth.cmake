include_guard(GLOBAL)
if(NOT TARGET stereoforge_daxa_preprocess)
  message(FATAL_ERROR "DaxaDepth requires the optional native preprocessing target")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}" shaders/daxa/depth.slang shaders/ops/stereo_observation.slang)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/daxa/depth.slang" SF_DAXA_DEPTH_WRAPPER_SHA256)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/ops/stereo_observation.slang" SF_DAXA_DEPTH_OPS_SHA256)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/daxa/depth_derived.slang" SF_DAXA_DEPTH_DERIVED_SHA256)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS shaders/daxa/depth_derived.slang)
set(sf_depth_spirv)
foreach(entry lr_consistency metric_observation metric_observation_derived)
  set(source "${CMAKE_CURRENT_SOURCE_DIR}/shaders/daxa/depth.slang")
  if(entry MATCHES "_derived")
    set(source "${CMAKE_CURRENT_SOURCE_DIR}/shaders/daxa/depth_derived.slang")
  endif()
  set(output "${CMAKE_CURRENT_BINARY_DIR}/daxa-depth-${entry}.spv")
  add_custom_command(OUTPUT "${output}"
    COMMAND "${SF_DAXA_SLANGC}" "${source}"
      -target spirv -profile spirv_1_5 -restrictive-capability-check -matrix-layout-row-major -fvk-use-scalar-layout -O3
      -entry "${entry}" -stage compute -o "${output}"
    DEPENDS "${source}" shaders/daxa/depth.slang shaders/ops/stereo_observation.slang VERBATIM)
  list(APPEND sf_depth_spirv "${output}")
endforeach()
add_custom_target(daxa_depth_shaders DEPENDS ${sf_depth_spirv})
add_library(stereoforge_daxa_depth src/daxa_depth.cpp)
target_link_libraries(stereoforge_daxa_depth PUBLIC stereoforge_daxa_preprocess PRIVATE GPUOpen::VulkanMemoryAllocator)
target_compile_definitions(stereoforge_daxa_depth PRIVATE SF_DAXA_DEPTH_DERIVED_SHA256="${SF_DAXA_DEPTH_DERIVED_SHA256}" SF_DAXA_DEPTH_SPIRV_DIRECTORY="${CMAKE_CURRENT_BINARY_DIR}" SF_DAXA_DEPTH_WRAPPER_SHA256="${SF_DAXA_DEPTH_WRAPPER_SHA256}" SF_DAXA_DEPTH_OPS_SHA256="${SF_DAXA_DEPTH_OPS_SHA256}")
add_dependencies(stereoforge_daxa_depth daxa_depth_shaders)
add_executable(daxa_depth_benchmark apps/daxa_depth_benchmark.cpp)
target_link_libraries(daxa_depth_benchmark PRIVATE stereoforge_daxa_depth)
target_include_directories(daxa_depth_benchmark PRIVATE "${sf_native_json_SOURCE_DIR}")
if(BUILD_TESTING)
  add_executable(daxa_depth_contracts tests/daxa_depth.cpp)
  target_link_libraries(daxa_depth_contracts PRIVATE stereoforge_daxa_depth)
  add_test(NAME daxa_depth_cpu_contracts COMMAND daxa_depth_contracts --cpu-only)
  add_test(NAME daxa_depth_gpu_contracts COMMAND daxa_depth_contracts --gpu)
  set_tests_properties(daxa_depth_gpu_contracts PROPERTIES LABELS "vulkan;hardware;daxa")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DaxaTemporal.cmake")
